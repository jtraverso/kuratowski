module

public import Mathlib
public import LeanPool.K5MinorFreeChoosability.Wagner.WagnerA
public import LeanPool.K5MinorFreeChoosability.Planar.Examples
public import LeanPool.K5MinorFreeChoosability.Planar.Nonplanar
public import Kuratowski.Subdivision
public import Kuratowski.TopToMinor

/-!
# Proofs of the statements in `Challenge.lean`

The definitions below are verbatim copies of those in `Challenge.lean`.
* Planarity coincides with that of the `LeanPool.K5MinorFreeChoosability` library
  (`isPlanar_iff_lib`), and minors with the library's minors (`isMinor_iff_lib`); Wagner's theorem
  is the library's `isPlanar_iff_k5MinorFree_and_k33MinorFree`.
* The minor and subdivision models coincide field by field with those of `Kuratowski/Defs.lean`,
  where the three subdivision lemmas are proved (`Kuratowski/TopToMinor.lean`,
  `Kuratowski/Terminal.lean`, `Kuratowski/Subdivision.lean`).
* Kuratowski's theorem follows: a subdivision of `K₅` or `K₃,₃` is a minor, and a `K₅` or `K₃,₃`
  minor yields a subdivision of `K₅` or `K₃,₃`.
-/

@[expose] public section

noncomputable section

open Equiv Equiv.Perm

universe u

namespace KuratowskiTheorem

/-! ### Combinatorial planarity -/

section Hypermap

variable {α : Type*}

/-- The number of equivalence classes of a setoid. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The number of cycles of a permutation (fixed points count as cycles of length one). -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

/-- The relation "in the same orbit of the group generated by `σ` and `τ`". -/
def compSetoid (σ τ : Perm α) : Setoid α where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = τ a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `τ`. -/
noncomputable def numComponents (σ τ : Perm α) : ℕ := numClasses (compSetoid σ τ)

/-- The Euler defect `|α| + 2 K - c(σ) - c(τ) - c(σ τ)` of the hypermap `(σ, τ)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ τ : Perm α) : ℤ :=
  (Nat.card α : ℤ) + 2 * (numComponents σ τ : ℤ) - cycleCount σ - cycleCount τ -
    cycleCount (σ * τ)

end Hypermap

section Planar

variable {V : Type*} (G : SimpleGraph V)

/-- The dart reversal `d ↦ d.symm` of `G`, as a permutation of the darts. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

/-- A rotation system: a permutation of the darts preserving tails and cyclic on the darts at
each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- A plane map of `G`: a rotation system of genus zero (Euler defect `0`). -/
structure PlaneMap where
  /-- The rotation: the next dart around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` is planar: it has a plane map. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

end Planar

/-- The planarity notion of this file is that of the `K5MinorFreeChoosability` library. -/
theorem isPlanar_iff_lib {V : Type*} (G : SimpleGraph V) :
    IsPlanar G ↔ LeanPool.K5MinorFreeChoosability.IsPlanar G := by
  constructor
  · rintro ⟨M⟩
    exact ⟨⟨M.rot, ⟨M.isRotationSystem.1, M.isRotationSystem.2⟩, M.eulerDefect_eq_zero⟩⟩
  · rintro ⟨M⟩
    exact ⟨⟨M.rot, ⟨M.isRotationSystem.1, M.isRotationSystem.2⟩, M.eulerDefect_eq_zero⟩⟩

/-! ### Sanity checks on the definition of planarity -/

/-- `K₄` is planar. -/
theorem isPlanar_K4 : IsPlanar (⊤ : SimpleGraph (Fin 4)) :=
  (isPlanar_iff_lib _).2 LeanPool.K5MinorFreeChoosability.isPlanar_K4

/-- `K₅` is not planar. -/
theorem not_isPlanar_K5 : ¬ IsPlanar (⊤ : SimpleGraph (Fin 5)) := fun h =>
  LeanPool.K5MinorFreeChoosability.not_isPlanar_K5 ((isPlanar_iff_lib _).1 h)

/-- `K₃,₃` is not planar. -/
theorem not_isPlanar_K33 : ¬ IsPlanar (completeBipartiteGraph (Fin 3) (Fin 3)) := fun h =>
  LeanPool.K5MinorFreeChoosability.not_isPlanar_K33 ((isPlanar_iff_lib _).1 h)



/-! ### Minors and subdivisions -/

section Minors

open SimpleGraph

variable {V W : Type*}

/-- A branch-set model of `H` as a minor of `G`: disjoint, nonempty, connected branch sets, one
for every vertex of `H`, with an edge of `G` between the branch sets of adjacent vertices. -/
structure MinorModel (G : SimpleGraph V) (H : SimpleGraph W) where
  branch : W → Finset V
  branch_nonempty : ∀ w, (branch w).Nonempty
  branch_connected : ∀ w, (G.induce (↑(branch w) : Set V)).Connected
  branch_disjoint : ∀ w w', w ≠ w' → Disjoint (branch w) (branch w')
  branch_adjacent : ∀ w w', H.Adj w w' → ∃ u ∈ branch w, ∃ v ∈ branch w', G.Adj u v

/-- `H` is a minor of `G`. -/
def IsMinor (H : SimpleGraph W) (G : SimpleGraph V) : Prop := Nonempty (MinorModel G H)

/-- A subdivision of `H` in `G`: distinct branch vertices, and for every ordered pair of adjacent
vertices of `H` a path of `G` joining their branch vertices, which contains no other branch
vertex; paths of different edges of `H` meet only at branch vertices. -/
structure TopologicalMinorModel (G : SimpleGraph V) (H : SimpleGraph W) where
  vertex : W ↪ V
  path : ∀ w w', H.Adj w w' → G.Walk (vertex w) (vertex w')
  path_isPath : ∀ w w' (h : H.Adj w w'), (path w w' h).IsPath
  path_branch : ∀ w w' (h : H.Adj w w') (u : W), vertex u ∈ (path w w' h).support →
    u = w ∨ u = w'
  path_disjoint : ∀ w₁ w₁' (h₁ : H.Adj w₁ w₁') w₂ w₂' (h₂ : H.Adj w₂ w₂'),
    s(w₁, w₁') ≠ s(w₂, w₂') → ∀ v ∈ (path w₁ w₁' h₁).support, v ∈ (path w₂ w₂' h₂).support →
      v ∈ Set.range vertex

/-- `H` is a topological minor of `G`: `G` contains a subdivision of `H`. -/
def IsTopologicalMinor (H : SimpleGraph W) (G : SimpleGraph V) : Prop :=
  Nonempty (TopologicalMinorModel G H)

end Minors

/-! ### Bridges -/

/-- The minor notion of this file is that of the library. -/
theorem isMinor_iff_lib {V W : Type*} (H : SimpleGraph W) (G : SimpleGraph V) :
    IsMinor H G ↔ LeanPool.K5MinorFreeChoosability.IsMinor H G := by
  constructor
  · rintro ⟨M⟩
    exact ⟨⟨M.branch, M.branch_nonempty, M.branch_connected, M.branch_disjoint,
      M.branch_adjacent⟩⟩
  · rintro ⟨M⟩
    exact ⟨⟨M.branch, M.branch_nonempty, M.branch_connected, M.branch_disjoint,
      M.branch_adjacent⟩⟩

/-- The minor notion of this file is that of `Kuratowski/Defs.lean`. -/
theorem isMinor_iff_kur {V W : Type*} (H : SimpleGraph W) (G : SimpleGraph V) :
    IsMinor H G ↔ Kuratowski.IsMinor H G := by
  constructor
  · rintro ⟨M⟩
    exact ⟨⟨M.branch, M.branch_nonempty, M.branch_connected, M.branch_disjoint,
      M.branch_adjacent⟩⟩
  · rintro ⟨M⟩
    exact ⟨⟨M.branch, M.branch_nonempty, M.branch_connected, M.branch_disjoint,
      M.branch_adjacent⟩⟩

/-- The subdivision notion of this file is that of `Kuratowski/Defs.lean`. -/
theorem isTopologicalMinor_iff_kur {V W : Type*} (H : SimpleGraph W) (G : SimpleGraph V) :
    IsTopologicalMinor H G ↔ Kuratowski.IsTopologicalMinor H G := by
  constructor
  · rintro ⟨M⟩
    exact ⟨⟨M.vertex, M.path, M.path_isPath, M.path_branch, M.path_disjoint⟩⟩
  · rintro ⟨M⟩
    exact ⟨⟨M.vertex, M.path, M.path_isPath, M.path_branch, M.path_disjoint⟩⟩

/-- **Wagner's theorem (1937).** A finite graph is planar if and only if it has neither `K₅` nor
`K₃,₃` as a minor. -/
theorem isPlanar_iff_minorFree {V : Type*} [Finite V] (G : SimpleGraph V) :
    IsPlanar G ↔ ¬ IsMinor (⊤ : SimpleGraph (Fin 5)) G ∧
      ¬ IsMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G := by
  classical
  rw [isPlanar_iff_lib, isMinor_iff_lib, isMinor_iff_lib,
    ← LeanPool.K5MinorFreeChoosability.cliqueMinorFree_iff_not_isMinor]
  exact LeanPool.K5MinorFreeChoosability.isPlanar_iff_k5MinorFree_and_k33MinorFree G

/-! ### Subdivisions and minors of `K₅` and `K₃,₃` -/

/-- A subdivision of `H` in `G` gives `H` as a minor of `G`. -/
theorem isMinor_of_isTopologicalMinor {V W : Type*} [Finite W] {G : SimpleGraph V}
    {H : SimpleGraph W} (h : IsTopologicalMinor H G) : IsMinor H G := by
  obtain ⟨M⟩ := (isTopologicalMinor_iff_kur H G).1 h
  exact (isMinor_iff_kur H G).2 M.isMinor

/-- A `K₃,₃` minor gives a `K₃,₃` subdivision. -/
theorem isTopologicalMinor_K33_of_isMinor {V : Type*} {G : SimpleGraph V}
    (h : IsMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G) :
    IsTopologicalMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G :=
  (isTopologicalMinor_iff_kur _ G).2
    (Kuratowski.isTopologicalMinor_K33_of_isMinor ((isMinor_iff_kur _ G).1 h))

/-- A `K₅` minor gives a `K₅` subdivision or a `K₃,₃` subdivision. -/
theorem isTopologicalMinor_of_isMinor_K5 {V : Type*} {G : SimpleGraph V}
    (h : IsMinor (⊤ : SimpleGraph (Fin 5)) G) :
    IsTopologicalMinor (⊤ : SimpleGraph (Fin 5)) G ∨
      IsTopologicalMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G := by
  rw [isTopologicalMinor_iff_kur, isTopologicalMinor_iff_kur]
  exact Kuratowski.isTopologicalMinor_of_isMinor_K5 ((isMinor_iff_kur _ G).1 h)

/-! ### Kuratowski's theorem -/

/-- **Kuratowski's theorem (1930).** A finite graph is planar if and only if it contains no
subdivision of `K₅` and no subdivision of `K₃,₃`. -/
theorem isPlanar_iff {V : Type*} [Finite V] (G : SimpleGraph V) :
    IsPlanar G ↔ ¬ IsTopologicalMinor (⊤ : SimpleGraph (Fin 5)) G ∧
      ¬ IsTopologicalMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G := by
  rw [isPlanar_iff_minorFree]
  constructor
  · rintro ⟨h5, h33⟩
    exact ⟨fun h => h5 (isMinor_of_isTopologicalMinor h),
      fun h => h33 (isMinor_of_isTopologicalMinor h)⟩
  · rintro ⟨h5, h33⟩
    refine ⟨fun h => ?_, fun h => h33 (isTopologicalMinor_K33_of_isMinor h)⟩
    rcases isTopologicalMinor_of_isMinor_K5 h with h' | h'
    · exact h5 h'
    · exact h33 h'

end KuratowskiTheorem
