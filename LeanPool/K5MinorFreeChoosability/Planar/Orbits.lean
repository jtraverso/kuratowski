module

public import Mathlib

/-!
# Counting orbits of permutations

This file contains the finite counting facts behind the combinatorial genus of a map.

* `numClasses s` is the number of classes of an equivalence relation (as a natural number,
  via `Nat.card` of the quotient).
* `addPairSetoid s x y` is the equivalence relation obtained from `s` by also identifying
  `x` and `y`; adjoining one pair lowers the number of classes by at most one, and by exactly
  one if `x` and `y` were in different classes.
* `cycleCount π` is the number of cycles of a permutation `π`, *fixed points included*.
* `cycleCount_mul_swap_of_sameCycle` and `cycleCount_mul_swap_of_not_sameCycle`: multiplying
  a permutation on the right by a transposition `swap x y` splits the cycle through `x` and
  `y` into two if `x` and `y` lie in the same cycle, and merges the two cycles otherwise.
-/

@[expose] public section

namespace LeanPool.K5MinorFreeChoosability

open Equiv Equiv.Perm

variable {α : Type*}

/-! ### Number of classes of an equivalence relation -/

/-- The number of equivalence classes of `s`. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The equivalence relation generated by `s` and the extra pair `(x, y)`. -/
def addPairSetoid (s : Setoid α) (x y : α) : Setoid α where
  r a b := s a b ∨ (s a x ∧ s y b) ∨ (s a y ∧ s x b)
  iseqv := by
    refine ⟨fun a => Or.inl (s.refl a), ?_, ?_⟩
    · rintro a b (h | ⟨h1, h2⟩ | ⟨h1, h2⟩)
      · exact Or.inl (s.symm h)
      · exact Or.inr (Or.inr ⟨s.symm h2, s.symm h1⟩)
      · exact Or.inr (Or.inl ⟨s.symm h2, s.symm h1⟩)
    · rintro a b c (h | ⟨h1, h2⟩ | ⟨h1, h2⟩) (k | ⟨k1, k2⟩ | ⟨k1, k2⟩)
      · exact Or.inl (s.trans h k)
      · exact Or.inr (Or.inl ⟨s.trans h k1, k2⟩)
      · exact Or.inr (Or.inr ⟨s.trans h k1, k2⟩)
      · exact Or.inr (Or.inl ⟨h1, s.trans h2 k⟩)
      · exact Or.inr (Or.inl ⟨h1, k2⟩)
      · exact Or.inl (s.trans h1 k2)
      · exact Or.inr (Or.inr ⟨h1, s.trans h2 k⟩)
      · exact Or.inl (s.trans h1 k2)
      · exact Or.inr (Or.inr ⟨h1, k2⟩)

theorem addPairSetoid_of_rel {s : Setoid α} {x y a b : α} (h : s a b) :
    addPairSetoid s x y a b := Or.inl h

theorem addPairSetoid_pair (s : Setoid α) (x y : α) : addPairSetoid s x y x y :=
  Or.inr (Or.inl ⟨s.refl x, s.refl y⟩)

theorem numClasses_congr {s t : Setoid α} (h : ∀ a b, s a b ↔ t a b) :
    numClasses s = numClasses t := by
  have : s = t := Setoid.ext h
  subst this; rfl

/-- A coarser relation has at most as many classes. -/
theorem numClasses_le_of_le [Finite α] {s t : Setoid α} (h : ∀ a b, s a b → t a b) :
    numClasses t ≤ numClasses s := by
  refine Nat.card_le_card_of_surjective
    (Quotient.lift (fun a => Quotient.mk t a) (fun a b hab => Quotient.sound (h a b hab))) ?_
  intro q
  induction q using Quotient.inductionOn with
  | h a => exact ⟨Quotient.mk s a, rfl⟩

theorem numClasses_le_card [Finite α] (s : Setoid α) : numClasses s ≤ Nat.card α :=
  Nat.card_le_card_of_surjective (Quotient.mk s) Quotient.mk_surjective

/-- Transport of the number of classes along an equivalence of types. -/
theorem numClasses_congr_equiv {β : Type*} {s : Setoid α} {t : Setoid β} (e : α ≃ β)
    (h : ∀ a b, s a b ↔ t (e a) (e b)) : numClasses s = numClasses t :=
  Nat.card_congr (Quotient.congr e h)

private theorem injOn_lift_addPair (s : Setoid α) (x y : α) :
    Set.InjOn (Quotient.lift (fun a => Quotient.mk (addPairSetoid s x y) a)
      (fun _ _ hab => Quotient.sound (Or.inl hab)) : Quotient s → _)
      {q | q ≠ Quotient.mk s y} := by
  intro p hp q hq hpq
  induction p using Quotient.inductionOn with
  | h a =>
  induction q using Quotient.inductionOn with
  | h b =>
  simp only [Set.mem_ofPred_eq, ne_eq] at hp hq
  have hab : addPairSetoid s x y a b := Quotient.exact hpq
  rcases hab with h | ⟨_, h2⟩ | ⟨h1, _⟩
  · exact Quotient.sound h
  · exact absurd (Quotient.sound (s.symm h2)) hq
  · exact absurd (Quotient.sound h1) hp

/-- Adjoining one pair lowers the number of classes by at most one. -/
theorem numClasses_le_addPair_succ [Finite α] (s : Setoid α) (x y : α) :
    numClasses s ≤ numClasses (addPairSetoid s x y) + 1 := by
  classical
  have := Fintype.ofFinite α
  set f := (Quotient.lift (fun a => Quotient.mk (addPairSetoid s x y) a)
      (fun a b hab => Quotient.sound (Or.inl hab)) : Quotient s → _) with hf
  have hinj : Set.InjOn f ↑(Finset.univ.erase (Quotient.mk s y)) := by
    intro p hp q hq hpq
    exact injOn_lift_addPair s x y (by simpa using hp) (by simpa using hq) hpq
  have h1 := Finset.card_le_card_of_injOn f (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _))
    hinj
  rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Finset.card_univ] at h1
  simp only [numClasses, Nat.card_eq_fintype_card]
  omega

/-- Adjoining a pair from two different classes lowers the number of classes by exactly
one. -/
theorem numClasses_addPair_of_not [Finite α] {s : Setoid α} {x y : α} (hxy : ¬ s x y) :
    numClasses s = numClasses (addPairSetoid s x y) + 1 := by
  classical
  have := Fintype.ofFinite α
  set f := (Quotient.lift (fun a => Quotient.mk (addPairSetoid s x y) a)
      (fun a b hab => Quotient.sound (Or.inl hab)) : Quotient s → _) with hf
  have hinj : Set.InjOn f ↑(Finset.univ.erase (Quotient.mk s y)) := by
    intro p hp q hq hpq
    exact injOn_lift_addPair s x y (by simpa using hp) (by simpa using hq) hpq
  have himg : (Finset.univ.erase (Quotient.mk s y)).image f = Finset.univ := by
    apply Finset.eq_univ_of_forall
    intro q
    induction q using Quotient.inductionOn with
    | h a =>
    rw [Finset.mem_image]
    by_cases ha : Quotient.mk s a = Quotient.mk s y
    · refine ⟨Quotient.mk s x, ?_, ?_⟩
      · rw [Finset.mem_erase]
        exact ⟨fun h => hxy (Quotient.exact h), Finset.mem_univ _⟩
      · have hay : s a y := Quotient.exact ha
        exact Quotient.sound (Or.inr (Or.inl ⟨s.refl x, s.symm hay⟩))
    · exact ⟨Quotient.mk s a, Finset.mem_erase.2 ⟨ha, Finset.mem_univ _⟩, rfl⟩
  have h1 := Finset.card_image_of_injOn hinj
  rw [himg, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ,
    Finset.card_univ] at h1
  have hpos : 0 < Fintype.card (Quotient s) :=
    Fintype.card_pos_iff.2 ⟨Quotient.mk s x⟩
  simp only [numClasses, Nat.card_eq_fintype_card]
  omega

/-- Counting classes from below: if every class has at least `k` elements, then
`k * numClasses s ≤ |α|`. -/
theorem mul_numClasses_le [Finite α] (s : Setoid α) (k : ℕ)
    (hk : ∀ a, k ≤ Nat.card {b // s a b}) : k * numClasses s ≤ Nat.card α := by
  classical
  have := Fintype.ofFinite α
  have hsum := Finset.card_eq_sum_card_fiberwise
    (f := Quotient.mk s) (s := (Finset.univ : Finset α)) (t := Finset.univ)
    (fun _ _ => Finset.mem_coe.2 (Finset.mem_univ _))
  have hfib : ∀ q : Quotient s, k ≤ (Finset.univ.filter fun a => Quotient.mk s a = q).card := by
    intro q
    induction q using Quotient.inductionOn with
    | h a =>
    refine le_trans (hk a) ?_
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    apply Finset.card_le_card
    intro b hb
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hb ⊢
    exact Quotient.sound (s.symm hb)
  have : ∑ q : Quotient s, k ≤ ∑ q : Quotient s,
      (Finset.univ.filter fun a => Quotient.mk s a = q).card :=
    Finset.sum_le_sum fun q _ => hfib q
  simp only [Finset.sum_const, Finset.card_univ, smul_eq_mul] at this
  simp only [numClasses, Nat.card_eq_fintype_card]
  rw [Finset.card_univ] at hsum
  rw [mul_comm]
  omega

/-- Restricting to a subset `p` whose complement consists of singleton classes. -/
theorem numClasses_eq_restrict (s : Setoid α) (p : α → Prop) (t : Setoid (Subtype p))
    (ht : ∀ a b : Subtype p, t a b ↔ s a b) (hout : ∀ a b, ¬ p a → s a b → a = b)
    [Finite α] :
    numClasses s = numClasses t + Nat.card {x // ¬ p x} := by
  classical
  let g : Quotient t ⊕ {x // ¬ p x} → Quotient s := fun
    | Sum.inl q => Quotient.lift (fun a : Subtype p => Quotient.mk s a.1)
        (fun a b hab => Quotient.sound ((ht a b).1 hab)) q
    | Sum.inr x => Quotient.mk s x.1
  have hg : Function.Bijective g := by
    constructor
    · rintro (q | x) (q' | x') h
      · induction q using Quotient.inductionOn with
        | h a =>
        induction q' using Quotient.inductionOn with
        | h b =>
        exact congrArg Sum.inl (Quotient.sound ((ht a b).2 (Quotient.exact h)))
      · induction q using Quotient.inductionOn with
        | h a =>
        have h' : s x'.1 a.1 := s.symm (Quotient.exact h)
        exact absurd (hout _ _ x'.2 h' ▸ a.2) x'.2
      · induction q' using Quotient.inductionOn with
        | h a =>
        have h' : s x.1 a.1 := Quotient.exact h
        exact absurd (hout _ _ x.2 h' ▸ a.2) x.2
      · have h' : s x.1 x'.1 := Quotient.exact h
        exact congrArg Sum.inr (Subtype.ext (hout _ _ x.2 h'))
    · intro q
      induction q using Quotient.inductionOn with
      | h a =>
      by_cases ha : p a
      · exact ⟨Sum.inl (Quotient.mk t ⟨a, ha⟩), rfl⟩
      · exact ⟨Sum.inr ⟨a, ha⟩, rfl⟩
  have := Fintype.ofFinite α
  have h1 := Nat.card_eq_of_bijective g hg
  rw [Nat.card_sum] at h1
  exact h1.symm

/-! ### Cycles of a permutation -/

/-- The number of cycles of `π`, counting fixed points as cycles of length one. -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

theorem sameCycle_of_step (s : Setoid α) {π : Perm α} (h : ∀ z, s z (π z)) {a b : α}
    (hab : SameCycle π a b) : s a b := by
  obtain ⟨i, rfl⟩ := hab
  induction i using Int.induction_on with
  | zero => exact s.refl a
  | succ i ih =>
    rw [add_comm, zpow_add, zpow_one, Perm.mul_apply]
    exact s.trans ih (h _)
  | pred i ih =>
    have h2 := h ((π ^ (-(i : ℤ) - 1)) a)
    rw [← Perm.mul_apply, ← zpow_one_add] at h2
    rw [show (1 : ℤ) + (-(i : ℤ) - 1) = -i by ring] at h2
    exact s.trans ih (s.symm h2)

variable [DecidableEq α]

/-- The general step relation between `π` and `π * swap x y`: every `π`-cycle relation
holds in the relation generated by the cycles of `π * swap x y` and the pair `(x, y)`. -/
theorem sameCycle_le_addPair_mulSwap (π : Perm α) (x y : α) {a b : α}
    (h : SameCycle π a b) : addPairSetoid (SameCycle.setoid (π * swap x y)) x y a b := by
  refine sameCycle_of_step _ (fun z => ?_) h
  by_cases hzx : z = x
  · subst hzx
    refine Or.inr (Or.inl ⟨SameCycle.refl _ _, ?_⟩)
    have : π z = (π * swap z y) y := by simp
    rw [this]
    exact (sameCycle_apply_right).2 (SameCycle.refl _ _)
  by_cases hzy : z = y
  · subst hzy
    refine Or.inr (Or.inr ⟨SameCycle.refl _ _, ?_⟩)
    have : π z = (π * swap x z) x := by simp
    rw [this]
    exact (sameCycle_apply_right).2 (SameCycle.refl _ _)
  · refine Or.inl ?_
    have : π z = (π * swap x y) z := by simp [swap_apply_of_ne_of_ne hzx hzy]
    rw [this]
    exact (sameCycle_apply_right).2 (SameCycle.refl _ _)

/-- If `x` and `y` lie in the same cycle of `π`, every cycle of `π * swap x y` lies inside
a cycle of `π`. -/
theorem sameCycle_of_sameCycle_mulSwap {π : Perm α} {x y : α} (hxy : SameCycle π x y)
    {a b : α} (h : SameCycle (π * swap x y) a b) : SameCycle π a b := by
  refine sameCycle_of_step (SameCycle.setoid π) (fun z => ?_) h
  change SameCycle π z ((π * swap x y) z)
  by_cases hzx : z = x
  · subst hzx
    simp only [Perm.mul_apply, swap_apply_left]
    exact hxy.trans ((sameCycle_apply_right).2 (SameCycle.refl _ _))
  by_cases hzy : z = y
  · subst hzy
    simp only [Perm.mul_apply, swap_apply_right]
    exact hxy.symm.trans ((sameCycle_apply_right).2 (SameCycle.refl _ _))
  · simp only [Perm.mul_apply, swap_apply_of_ne_of_ne hzx hzy]
    exact (sameCycle_apply_right).2 (SameCycle.refl _ _)

theorem mulSwap_mulSwap (π : Perm α) (x y : α) : π * swap x y * swap x y = π := by
  rw [mul_assoc, swap_mul_self, mul_one]

/-- Iterating `π * swap x y` from `y` follows the `π`-orbit of `x` as long as it avoids `x`
and `y`. -/
theorem pow_mulSwap_apply (π : Perm α) (x y : α) (m : ℕ)
    (hm : ∀ i, 0 < i → i < m → (π ^ i) x ≠ x ∧ (π ^ i) x ≠ y) :
    ∀ j, 0 < j → j ≤ m → ((π * swap x y) ^ j) y = (π ^ j) x := by
  intro j hj hjm
  induction j with
  | zero => exact absurd hj (lt_irrefl 0)
  | succ j ih =>
    rcases Nat.eq_zero_or_pos j with rfl | hj0
    · simp
    · rw [pow_succ', Perm.mul_apply, ih hj0 (by omega), pow_succ' π, Perm.mul_apply π]
      obtain ⟨h1, h2⟩ := hm j hj0 (by omega)
      simp [swap_apply_of_ne_of_ne h1 h2]

omit [DecidableEq α] in
private theorem exists_min_pow (π : Perm α) [Finite α] (x t : α) (ht : SameCycle π x t) :
    ∃ m, 0 < m ∧ (π ^ m) x = t ∧ ∀ i, 0 < i → i < m → (π ^ i) x ≠ t := by
  classical
  have hex : ∃ m, 0 < m ∧ (π ^ m) x = t := by
    obtain ⟨i, hi⟩ := ht.exists_nat_pow_eq
    refine ⟨i + orderOf π, ?_, ?_⟩
    · have := orderOf_pos π
      omega
    · rw [add_comm, pow_add, pow_orderOf_eq_one, one_mul, hi]
  refine ⟨Nat.find hex, (Nat.find_spec hex).1, (Nat.find_spec hex).2, ?_⟩
  intro i hi hlt heq
  exact Nat.find_min hex hlt ⟨hi, heq⟩

/-- If `x` and `y` lie in different cycles of `π`, they lie in the same cycle of
`π * swap x y`. -/
theorem sameCycle_mulSwap_of_not [Finite α] {π : Perm α} {x y : α}
    (h : ¬ SameCycle π x y) : SameCycle (π * swap x y) x y := by
  obtain ⟨m, hm0, hmx, hmin⟩ := exists_min_pow π x x (SameCycle.refl _ _)
  have key := pow_mulSwap_apply π x y m (fun i hi hlt => ⟨hmin i hi hlt, fun he =>
    h (he ▸ ⟨(i : ℤ), by simp⟩)⟩) m hm0 le_rfl
  rw [hmx] at key
  have h2 : SameCycle (π * swap x y) y x := ⟨(m : ℤ), by simpa using key⟩
  exact h2.symm

omit [DecidableEq α] in
private theorem pow_apply_mod {π : Perm α} {y : α} {m : ℕ} (hm : (π ^ m) y = y) (k : ℕ) :
    (π ^ k) y = (π ^ (k % m)) y := by
  conv_lhs => rw [← Nat.mod_add_div k m, pow_add, Perm.mul_apply, pow_mul]
  congr 1
  induction k / m with
  | zero => simp
  | succ n ih => rw [pow_succ, Perm.mul_apply, hm, ih]

/-- If `x ≠ y` lie in the same cycle of `π`, they lie in different cycles of
`π * swap x y`. -/
theorem not_sameCycle_mulSwap_of_sameCycle [Finite α] {π : Perm α} {x y : α} (hne : x ≠ y)
    (h : SameCycle π x y) : ¬ SameCycle (π * swap x y) x y := by
  obtain ⟨m, hm0, hmy, hmin⟩ := exists_min_pow π x y h
  have hnx : ∀ i, 0 < i → i < m → (π ^ i) x ≠ x := by
    intro i hi hlt he
    apply hmin (m - i) (by omega) (by omega)
    have : (π ^ m) x = (π ^ (m - i)) ((π ^ i) x) := by
      rw [← Perm.mul_apply, ← pow_add, Nat.sub_add_cancel hlt.le]
    rw [he] at this
    rw [← this, hmy]
  have key := pow_mulSwap_apply π x y m (fun i hi hlt => ⟨hnx i hi hlt, hmin i hi hlt⟩)
  have hper : ((π * swap x y) ^ m) y = y := by rw [key m hm0 le_rfl, hmy]
  intro hs
  obtain ⟨k, hk⟩ := hs.symm.exists_nat_pow_eq
  rw [pow_apply_mod hper] at hk
  have hlt : k % m < m := Nat.mod_lt _ hm0
  rcases Nat.eq_zero_or_pos (k % m) with h0 | h0
  · rw [h0] at hk
    exact hne (by simpa using hk.symm)
  · rw [key _ h0 hlt.le] at hk
    exact hnx _ h0 hlt hk

/-- Splitting a cycle: if `x ≠ y` lie in the same cycle of `π`, then `π * swap x y` has one
more cycle. -/
theorem cycleCount_mul_swap_of_sameCycle [Finite α] {π : Perm α} {x y : α} (hne : x ≠ y)
    (h : SameCycle π x y) : cycleCount (π * swap x y) = cycleCount π + 1 := by
  have hn := not_sameCycle_mulSwap_of_sameCycle hne h
  have hiff : ∀ a b, SameCycle.setoid π a b ↔
      addPairSetoid (SameCycle.setoid (π * swap x y)) x y a b := by
    intro a b
    refine ⟨sameCycle_le_addPair_mulSwap π x y, ?_⟩
    rintro (k | ⟨k1, k2⟩ | ⟨k1, k2⟩)
    · exact sameCycle_of_sameCycle_mulSwap h k
    · exact ((sameCycle_of_sameCycle_mulSwap h k1).trans h).trans
        (sameCycle_of_sameCycle_mulSwap h k2)
    · exact ((sameCycle_of_sameCycle_mulSwap h k1).trans h.symm).trans
        (sameCycle_of_sameCycle_mulSwap h k2)
  unfold cycleCount
  rw [numClasses_congr hiff,
    numClasses_addPair_of_not (s := SameCycle.setoid (π * swap x y)) hn]

/-- Merging two cycles: if `x` and `y` lie in different cycles of `π`, then `π * swap x y`
has one fewer cycle. -/
theorem cycleCount_mul_swap_of_not_sameCycle [Finite α] {π : Perm α} {x y : α}
    (h : ¬ SameCycle π x y) : cycleCount (π * swap x y) + 1 = cycleCount π := by
  have hs := sameCycle_mulSwap_of_not h
  have hle : ∀ {a b}, SameCycle π a b → SameCycle (π * swap x y) a b := by
    intro a b k
    have k' : SameCycle (π * swap x y * swap x y) a b := by rwa [mulSwap_mulSwap]
    exact sameCycle_of_sameCycle_mulSwap hs k'
  have hiff : ∀ a b, SameCycle.setoid (π * swap x y) a b ↔
      addPairSetoid (SameCycle.setoid π) x y a b := by
    intro a b
    constructor
    · intro k
      have := sameCycle_le_addPair_mulSwap (π * swap x y) x y k
      rwa [mulSwap_mulSwap] at this
    · rintro (k | ⟨k1, k2⟩ | ⟨k1, k2⟩)
      · exact hle k
      · exact ((hle k1).trans hs).trans (hle k2)
      · exact ((hle k1).trans hs.symm).trans (hle k2)
  unfold cycleCount
  rw [numClasses_congr hiff, numClasses_addPair_of_not (s := SameCycle.setoid π) h]

omit [DecidableEq α] in
theorem cycleCount_le_card [Finite α] (π : Perm α) : cycleCount π ≤ Nat.card α :=
  numClasses_le_card _

omit [DecidableEq α] in
/-- The identity permutation has `|α|` cycles. -/
theorem cycleCount_one : cycleCount (1 : Perm α) = Nat.card α := by
  unfold cycleCount numClasses
  refine Nat.card_congr (Equiv.ofBijective (Quotient.lift id ?_) ⟨?_, ?_⟩)
  · intro a b h
    obtain ⟨i, hi⟩ := h
    simpa using hi
  · intro p q hpq
    induction p using Quotient.inductionOn with
    | h a =>
    induction q using Quotient.inductionOn with
    | h b =>
    exact Quotient.sound (show SameCycle 1 a b from ⟨0, by simpa using hpq⟩)
  · intro a
    exact ⟨Quotient.mk _ a, rfl⟩

/-- Remove `z` from its cycle of `π`, making it a fixed point; the other elements keep their
cyclic order. -/
def removeFromCycle (π : Perm α) (z : α) : Perm α := π * swap (π⁻¹ z) z

theorem removeFromCycle_apply_self (π : Perm α) (z : α) : removeFromCycle π z z = z := by
  simp [removeFromCycle]

theorem removeFromCycle_apply (π : Perm α) {z u : α} (huz : u ≠ z) :
    removeFromCycle π z u = if π u = z then π z else π u := by
  unfold removeFromCycle
  by_cases hu : u = π⁻¹ z
  · subst hu
    simp
  · have hne : π u ≠ z := fun h => hu (by rw [← h]; simp)
    rw [Perm.mul_apply, swap_apply_of_ne_of_ne hu huz]
    simp [hne]

/-- Removing `z` keeps the cycle relation among the other elements. -/
theorem sameCycle_removeFromCycle {π : Perm α} {z u v : α} (hu : u ≠ z)
    (hv : v ≠ z) (h : SameCycle π u v) : SameCycle (removeFromCycle π z) u v := by
  have h' := sameCycle_le_addPair_mulSwap π (π⁻¹ z) z h
  have hfix : ∀ w, SameCycle (removeFromCycle π z) z w → w = z := fun w hw =>
    (hw.eq_of_left (removeFromCycle_apply_self π z)).symm
  rcases h' with k | ⟨_, k2⟩ | ⟨k1, _⟩
  · exact k
  · exact absurd (hfix v k2) hv
  · exact absurd (hfix u k1.symm) hu

theorem removeFromCycle_eq_of_fixed {π : Perm α} {z : α} (hz : π⁻¹ z = z) :
    removeFromCycle π z = π := by
  rw [removeFromCycle, hz, swap_self]
  exact mul_one π

omit [DecidableEq α] in
theorem sameCycle_inv_apply_self (π : Perm α) (z : α) : SameCycle π (π⁻¹ z) z :=
  ⟨1, by simp⟩

end LeanPool.K5MinorFreeChoosability
