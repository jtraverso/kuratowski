module

public import Mathlib

/-!
# Kuratowski's theorem

This file states, for finite simple graphs:

1. **Kuratowski's theorem (1930).** A finite graph is planar if and only if it contains no
   subdivision of `K₅` and no subdivision of `K₃,₃` (`KuratowskiTheorem.isPlanar_iff`).
2. A subdivision of `H` in `G` (a topological minor) gives `H` as a minor of `G`
   (`KuratowskiTheorem.isMinor_of_isTopologicalMinor`).
3. A `K₃,₃` minor gives a `K₃,₃` subdivision
   (`KuratowskiTheorem.isTopologicalMinor_K33_of_isMinor`), and a `K₅` minor gives a `K₅` or a
   `K₃,₃` subdivision (`KuratowskiTheorem.isTopologicalMinor_of_isMinor_K5`).

## Planarity

Mathlib has no notion of planar graph, so planarity is defined here combinatorially, through
rotation systems (combinatorial maps). A *rotation system* of `G` is a permutation `rot` of the
darts (oriented edges) of `G` that maps each dart to a dart with the same tail and is cyclic on
the darts at each vertex (a cyclic order of the edges around every vertex). Together with the
dart reversal `dartSymm`, it defines a hypermap, whose faces are the cycles of `rot * dartSymm`.
Its *Euler defect* is
`|D| + 2 K - c(rot) - c(dartSymm) - c(rot * dartSymm)`,
where `D` is the set of darts, `K` the number of orbits of the group generated by `rot` and
`dartSymm` (connected components with at least one edge) and `c(π)` the number of cycles of
`π`. For a finite graph it equals `2K - (V' - E + F)` summed over components, i.e. twice the
total genus, where `V'` counts non-isolated vertices. A **plane map** is a rotation system with
Euler defect `0` (every component has genus `0`), and `G` is **planar** if it has a plane map.

By the Heffter–Edmonds–Ringel rotation principle, rotation systems of genus `0` correspond to
embeddings of `G` in the sphere, so this is the usual notion of planarity for finite graphs;
that correspondence with topological embeddings is classical and is **not** formalized here.
As sanity checks on the definition we state that `K₄` is planar and that `K₅` and `K₃,₃` are
not.

## Minors and subdivisions

`H` is a minor of `G` if there are disjoint, nonempty, connected branch sets in `G`, one for every
vertex of `H`, with an edge of `G` between the branch sets of adjacent vertices of `H`. `G`
contains a subdivision of `H` (`H` is a topological minor of `G`) if there are distinct branch
vertices in `G`, one for every vertex of `H`, and for every pair of adjacent vertices of `H` a path
of `G` joining their branch vertices that contains no other branch vertex, the paths of different
edges of `H` meeting only at branch vertices.

The Mathlib definitions used in these statements are reproduced verbatim, with file and line at
the pinned Mathlib revision, in `MATHLIB_DEFINITIONS.md` at the root of this repository.
-/

@[expose] public section

noncomputable section

open Equiv Equiv.Perm

universe u

namespace KuratowskiTheorem

/-! ### Combinatorial planarity -/

section Hypermap

variable {α : Type*}

/-- The number of equivalence classes of a setoid. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The number of cycles of a permutation (fixed points count as cycles of length one). -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

/-- The relation "in the same orbit of the group generated by `σ` and `τ`". -/
def compSetoid (σ τ : Perm α) : Setoid α where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = τ a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `τ`. -/
noncomputable def numComponents (σ τ : Perm α) : ℕ := numClasses (compSetoid σ τ)

/-- The Euler defect `|α| + 2 K - c(σ) - c(τ) - c(σ τ)` of the hypermap `(σ, τ)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ τ : Perm α) : ℤ :=
  (Nat.card α : ℤ) + 2 * (numComponents σ τ : ℤ) - cycleCount σ - cycleCount τ -
    cycleCount (σ * τ)

end Hypermap

section Planar

variable {V : Type*} (G : SimpleGraph V)

/-- The dart reversal `d ↦ d.symm` of `G`, as a permutation of the darts. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

/-- A rotation system: a permutation of the darts preserving tails and cyclic on the darts at
each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- A plane map of `G`: a rotation system of genus zero (Euler defect `0`). -/
structure PlaneMap where
  /-- The rotation: the next dart around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` is planar: it has a plane map. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

end Planar

/-! ### Sanity checks on the definition of planarity -/

/-- `K₄` is planar. -/
theorem isPlanar_K4 : IsPlanar (⊤ : SimpleGraph (Fin 4)) := by
  sorry

/-- `K₅` is not planar. -/
theorem not_isPlanar_K5 : ¬ IsPlanar (⊤ : SimpleGraph (Fin 5)) := by
  sorry

/-- `K₃,₃` is not planar. -/
theorem not_isPlanar_K33 : ¬ IsPlanar (completeBipartiteGraph (Fin 3) (Fin 3)) := by
  sorry



/-! ### Minors and subdivisions -/

section Minors

open SimpleGraph

variable {V W : Type*}

/-- A branch-set model of `H` as a minor of `G`: disjoint, nonempty, connected branch sets, one
for every vertex of `H`, with an edge of `G` between the branch sets of adjacent vertices. -/
structure MinorModel (G : SimpleGraph V) (H : SimpleGraph W) where
  branch : W → Finset V
  branch_nonempty : ∀ w, (branch w).Nonempty
  branch_connected : ∀ w, (G.induce (↑(branch w) : Set V)).Connected
  branch_disjoint : ∀ w w', w ≠ w' → Disjoint (branch w) (branch w')
  branch_adjacent : ∀ w w', H.Adj w w' → ∃ u ∈ branch w, ∃ v ∈ branch w', G.Adj u v

/-- `H` is a minor of `G`. -/
def IsMinor (H : SimpleGraph W) (G : SimpleGraph V) : Prop := Nonempty (MinorModel G H)

/-- A subdivision of `H` in `G`: distinct branch vertices, and for every ordered pair of adjacent
vertices of `H` a path of `G` joining their branch vertices, which contains no other branch
vertex; paths of different edges of `H` meet only at branch vertices. -/
structure TopologicalMinorModel (G : SimpleGraph V) (H : SimpleGraph W) where
  vertex : W ↪ V
  path : ∀ w w', H.Adj w w' → G.Walk (vertex w) (vertex w')
  path_isPath : ∀ w w' (h : H.Adj w w'), (path w w' h).IsPath
  path_branch : ∀ w w' (h : H.Adj w w') (u : W), vertex u ∈ (path w w' h).support →
    u = w ∨ u = w'
  path_disjoint : ∀ w₁ w₁' (h₁ : H.Adj w₁ w₁') w₂ w₂' (h₂ : H.Adj w₂ w₂'),
    s(w₁, w₁') ≠ s(w₂, w₂') → ∀ v ∈ (path w₁ w₁' h₁).support, v ∈ (path w₂ w₂' h₂).support →
      v ∈ Set.range vertex

/-- `H` is a topological minor of `G`: `G` contains a subdivision of `H`. -/
def IsTopologicalMinor (H : SimpleGraph W) (G : SimpleGraph V) : Prop :=
  Nonempty (TopologicalMinorModel G H)

end Minors

/-! ### Subdivisions and minors of `K₅` and `K₃,₃` -/

/-- A subdivision of `H` in `G` gives `H` as a minor of `G`. -/
theorem isMinor_of_isTopologicalMinor {V W : Type*} [Finite W] {G : SimpleGraph V}
    {H : SimpleGraph W} (h : IsTopologicalMinor H G) : IsMinor H G := by
  sorry

/-- A `K₃,₃` minor gives a `K₃,₃` subdivision. -/
theorem isTopologicalMinor_K33_of_isMinor {V : Type*} {G : SimpleGraph V}
    (h : IsMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G) :
    IsTopologicalMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G := by
  sorry

/-- A `K₅` minor gives a `K₅` subdivision or a `K₃,₃` subdivision. -/
theorem isTopologicalMinor_of_isMinor_K5 {V : Type*} {G : SimpleGraph V}
    (h : IsMinor (⊤ : SimpleGraph (Fin 5)) G) :
    IsTopologicalMinor (⊤ : SimpleGraph (Fin 5)) G ∨
      IsTopologicalMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G := by
  sorry

/-! ### Kuratowski's theorem -/

/-- **Kuratowski's theorem (1930).** A finite graph is planar if and only if it contains no
subdivision of `K₅` and no subdivision of `K₃,₃`. -/
theorem isPlanar_iff {V : Type*} [Finite V] (G : SimpleGraph V) :
    IsPlanar G ↔ ¬ IsTopologicalMinor (⊤ : SimpleGraph (Fin 5)) G ∧
      ¬ IsTopologicalMinor (completeBipartiteGraph (Fin 3) (Fin 3)) G := by
  sorry

end KuratowskiTheorem
